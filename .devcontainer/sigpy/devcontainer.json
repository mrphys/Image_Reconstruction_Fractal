{
	// TF-free container for the sigpy backend. In VS Code: "Dev Containers: Reopen in Container" and pick "sigpy".
	"name": "sigpy",
	"dockerFile": "./Dockerfile",
	"context": "../..",
	"customizations": {
		"vscode": {
		  "extensions":  [
		"ms-python.python",
		"ms-toolsai.jupyter"
	]}
	},
	"runArgs": [
		// Enable GPUs (cupy). Remove on a CPU-only host; sigpy then runs on numpy.
		"--gpus=all"
	],
	"containerEnv": {
		"SYNTHMR_BACKEND": "sigpy"
	},
	"remoteUser": "vscode"
}
